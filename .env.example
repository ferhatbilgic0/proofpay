# Braintree sandbox keys (Braintree control panel > Settings > API)
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# AI provider: gemini, anthropic or mock. If unset, ProofPay picks whichever key is present, else mock.
AI_PROVIDER=gemini

# Google AI Studio key (free tier): https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Or Anthropic API key
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
